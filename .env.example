# Robinhood Chain mainnet (chain id 4663)
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- DeployFactory.s.sol: shared config + factory (once) ---
# Owner of the IndexConfig (may change threshold / incentive / redeem fee within the hard caps). Default: broadcaster.
OWNER=

# --- CreateVault.s.sol: one vault through the factory ---
FACTORY=0x0000000000000000000000000000000000000000

# One entry per asset, comma-separated, same order in every list.
# Example below: WETH (0x0Bd7...AD73, from Uniswap v2 Router02.WETH()) + a Robinhood Stock Token, 50/50.
ASSETS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73,0x0000000000000000000000000000000000000000

# Matching Chainlink USD feeds. All Robinhood Chain feeds: 8 decimals, 24h heartbeat, 0.5% deviation.
# ETH/USD 0x78F3556b67E17Df817D51Ef5a990cDaF09E8d3A9
FEEDS=0x78F3556b67E17Df817D51Ef5a990cDaF09E8d3A9,0x0000000000000000000000000000000000000000

# Target weights in basis points; must sum to 10000.
WEIGHTS_BPS=5000,5000

# Seconds a feed answer stays acceptable, applied to every feed. 24h heartbeat + 1h grace.
MAX_STALE=90000

# First deposit, made by the factory in the same transaction (raw token units, one per asset, all > 0).
# The broadcaster must hold these; the minted INDEX goes to the broadcaster.
SEED_AMOUNTS=1000000000000000000,1000000

INDEX_NAME="Hood 50/50 Index"
INDEX_SYMBOL=INDEX
