# Robinhood Chain mainnet (chain id 4663)
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- DeployFactory.s.sol: shared config + factory (once) ---
# Owner of the IndexConfig (may change threshold / incentive / redeem fee within the hard caps). Default: broadcaster.
OWNER=

# --- RegisterAssets.s.sol: register every verified (token, feed) pair from data/robinhood-chain-feeds.json ---
CONFIG=0x0000000000000000000000000000000000000000
# Seconds a feed answer stays acceptable, applied to every adapter. 24h heartbeat + 1h grace (fails closed over weekends).
MAX_STALE=90000

# --- DeployZap.s.sol: periphery zap (USDG -> index and back) ---
# Permit2 is at its canonical address on Robinhood Chain (verified 2026-10-02). ROUTERS: DEX routers the zap may call
# with caller-supplied calldata; verify each one. Known on 4663: Uniswap v2 Router02 0x89e5db8b5aa49aa85ac63f691524311aeb649eba,
# 1inch router 0x5A705DE8982235a7fa45bB83dCaCf03a211389C7.
PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3
ROUTERS=0x89e5db8b5aa49aa85ac63f691524311aeb649eba,0x5A705DE8982235a7fa45bB83dCaCf03a211389C7

# --- CreateVault.s.sol: one vault through the factory (assets must be registered first) ---
FACTORY=0x0000000000000000000000000000000000000000

# One entry per asset, comma-separated, same order in every list. Token addresses: data/robinhood-chain-feeds.json.
# Example below: WETH (0x0Bd7...AD73) + a Robinhood Stock Token, 50/50.
ASSETS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73,0x0000000000000000000000000000000000000000

# Target weights in basis points; must sum to 10000.
WEIGHTS_BPS=5000,5000

# First deposit, made by the factory in the same transaction (raw token units, one per asset, all > 0).
# The broadcaster must hold these; the minted INDEX goes to the broadcaster.
SEED_AMOUNTS=1000000000000000000,1000000

INDEX_NAME="Hood 50/50 Index"
INDEX_SYMBOL=INDEX
